# Supply values through the hosting provider's secret settings. Do not copy the local .env.
DATABASE_URL=postgresql://REPLACE_ME
BETTER_AUTH_URL=https://REPLACE_ME
BETTER_AUTH_SECRET=GENERATE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PETISH_DEMO=false
MAIL_MODE=smtp
STORAGE_DRIVER=s3
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM=REPLACE_ME
S3_ENDPOINT=https://REPLACE_ME
S3_REGION=REPLACE_ME
S3_BUCKET=REPLACE_ME
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
PORT=3000
